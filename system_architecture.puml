@startuml

package "robot"{
    package "Hardware layer"{
        [chassis_controller]
        [base_devices_controller]
        package "Additional devices"{
            [display_controller]
            [lidar_controller]
            [distance_sensors_controller]
            [line_sensor_controller]
        }
        [battery_status_controller]
        [case_state_controller]
    }

    package "Navigation layer"{
        [localisation_module**]
        [map_saver**]
        [path_planner**]
    }
    [current_vecktor_resolver**]
    [internal_state_reporter]
    [external_state_reporter]
    [general_state_machine]
    [external_control]
}

package "control device"{
    [robot_control]
    [graph_node]
}



note bottom of base_devices_controller
    Осуществляет управление
    и возвращает статус всех
    основных устройств рамы
    (фары, поворотники, 
    захваты и датчики касания)
end note

note top of "Additional devices"
    Дополнительные подключаемые устройсвая 
    (опционально изменяемая конфигурация)
end note

note top of "internal_state_reporter"
    Докладчик внутреннего состояния  для 
    контроля статуса робота  работать 
    и производить и опрос датчиков
end note

note top of "external_state_reporter"
    Докладчик внешнего состояния для
    контроля статуса выполняния задач
    и внешних событий управляющих 
    сигналов
end note

note bottom of "external_control"
    Нода осуществляющая передачу 
    внешнего управляющего сигнала
    и телеметрии
end note





chassis_controller -down-> [localisation_module**]: /odometry_vecktors
base_devices_controller -down-> [localisation_module**]: /imu_vecktors
lidar_controller -> [localisation_module**]: /lidar_dots
distance_sensors_controller -> [localisation_module**]: /distances
[localisation_module**] --> [map_saver**]: /coords
[localisation_module**] <--> [map_saver**]: /current_map**
[localisation_module**] --> [path_planner**]: /coords
[map_saver**] --> [path_planner**]: /access_map


base_devices_controller -up-> [internal_state_reporter]: /device_states**
case_state_controller -up--> [internal_state_reporter]: /case_states**
battery_status_controller -up-> [internal_state_reporter]: /battery_state

line_sensor_controller -up--> [external_state_reporter]: /line_sen_vals
distance_sensors_controller -up-> [external_state_reporter]: /distance_sen_vals

[path_planner**] --> [general_state_machine]: /path_vecktors
general_state_machine <-up- [internal_state_reporter]: /robot_state
general_state_machine <-up- [external_state_reporter]: /exterior_state
general_state_machine <-down-> [external_control]: /gen_robot_ctrl
general_state_machine -up-> [current_vecktor_resolver**]: /path_control
[localisation_module**] -right-> [current_vecktor_resolver**]: /coords
[current_vecktor_resolver**] -up-> [chassis_controller]: /chassis_trgt_vecktor

display_controller <- general_state_machine: /display_data
general_state_machine -up-> base_devices_controller: /base_device_ctrl

external_control <-down-> robot_control: /robot_ctrl_comm
external_control -down-> graph_node: /telemetry
@enduml
